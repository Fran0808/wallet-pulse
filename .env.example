# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finance_db
DB_USER=postgres
DB_PASSWORD=admin

# Backend API Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Frontend Dashboard Configuration (Vite)
VITE_API_URL=http://localhost:8080

# Gmail Ingestion Configuration (IMAP)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_google_app_password
GMAIL_SYNC_BATCH_SIZE=20

# Background Email Scheduler (Optional, set to true to enable auto-sync)
GMAIL_SYNC_ENABLED=false
GMAIL_SYNC_CRON=0 */5 * * * *

