# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finance_db
DB_USER=postgres
DB_PASSWORD=admin

# Backend API Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Frontend Dashboard Configuration (Vite)
VITE_API_URL=http://localhost:8080

# Gmail Ingestion Configuration (IMAP)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_google_app_password
GMAIL_SYNC_BATCH_SIZE=20

# Background Email Scheduler (Optional, set to true to enable auto-sync)
GMAIL_SYNC_ENABLED=false
GMAIL_SYNC_CRON=0 */5 * * * *

# Google OAuth2 & Gmail API Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
FRONTEND_SUCCESS_URL=http://localhost:5173?auth=google_connected
FRONTEND_ERROR_URL=http://localhost:5173?auth=google_error

# JWT Security Configuration
JWT_SECRET=your_jwt_secret_key_minimum_32_bytes_256_bit_hex
JWT_EXPIRATION_MS=604800000

